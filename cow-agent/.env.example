# cow-agent 环境变量模板（复制为 .env 后填写；.env 已被 .gitignore 排除，勿提交）

# LLM（OpenAI 兼容协议；DeepSeek 官方端点示例）
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-flash
LLM_API_KEY=sk-...

# cow-admin 业务接口与回调账号（与 DataInitializer 一致）
COW_ADMIN_BASE_URL=http://localhost:8081
AGENT_USER=svc-agent
AGENT_PASSWORD=SvcAgent@123

# 写操作审批超时（秒）
CONFIRM_TIMEOUT_SECONDS=120

# Agent 运行参数（默认值即可）
AGENT_MAX_TURNS=12
AGENT_HOME=./agent-home
APP_NAME=cow-agent
PORT=8003
