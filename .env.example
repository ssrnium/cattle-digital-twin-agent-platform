# 奶牛数字孪生平台 — docker-compose 根级环境变量模板
# 用法：cp .env.example .env，填 key 后 docker compose up -d --build
# （.env 已被 .gitignore 排除，勿提交）

# LLM（OpenAI 兼容协议，DeepSeek 官方端点；cow-agent 智能体对话必填）
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-flash
LLM_API_KEY=

# svc-agent 服务账号密码（与 admin 初始化一致）
AGENT_PASSWORD=SvcAgent@123

# JWT 签名密钥（公网部署务必改为长随机串）
JWT_SECRET=please-change-me-to-a-long-random-string

# 边缘模拟器设备凭证（仅 demo profile 用；生产必须更换）
DEVICE_KEY=edge-node-01-secret-2026
